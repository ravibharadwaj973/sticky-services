NODE_ENV=development
PORT=5001

# Same MongoDB as the core backend — this service just owns the `todos`
# collection. Copy MONGODB_URI from backend/.env.
MONGODB_URI=

# MUST be byte-identical to the core backend's JWT_SECRET. This service does not
# issue tokens, it only verifies the ones backend/routes/auth.js and
# backend/routes/admin.js hand out.
JWT_SECRET=

# Origins allowed to call this service (the CORS allowlist also covers
# localhost:3000, localhost:3001 and the EC2 IP by default).
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
