# ---------------------------------------------------------------------------
# Secrets come from AWS Secrets Manager. See "Part 3" in AWS_SETUP.md.
#
# Point this at the SAME secret as the core backend. JWT_SECRET has to be
# byte-identical in both services, and sharing one secret is what makes that
# true by construction instead of by copy-paste.
#
# This service reads only JWT_SECRET and MONGODB_URI out of the secret; the
# ADMIN_* keys belong to the core backend and are ignored here.
# ---------------------------------------------------------------------------
# AWS_SECRET_NAME=sticky-keys

# --- Non-secret config ---
NODE_ENV=development
PORT=5001

# Required whenever AWS_SECRET_NAME is set
AWS_REGION=ap-south-1

# Origins allowed to call this service (the CORS allowlist also covers
# localhost:3000, localhost:3001 and the EC2 IP by default).
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Secrets: only needed when AWS_SECRET_NAME is NOT set (local dev) ---
# Same cluster as the core backend; this service only touches `todos`.
MONGODB_URI=
# MUST match the core backend exactly — this service verifies tokens, never issues them
JWT_SECRET=

# NOTE: no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. This runs on EC2 and the
# SDK uses the instance's IAM role. Do not put access keys in this file.
